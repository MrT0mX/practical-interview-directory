{
  "name": "practical-interview-directory",
  "version": "0.1.0",
  "description": "A directory of companies with practical, role-related interview processes",
  "main": "index.js",
  "scripts": {
    "test": "node ./node_modules/remark-cli/cli.js README.md -f -q",
    "check:listings": "node scripts/check-listing-freshness.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrT0mX/practical-interview-directory.git"
  },
  "keywords": [
    "hiring",
    "technical-interviews",
    "practical-interviews",
    "whiteboard-free"
  ],
  "author": "MrT0mX",
  "license": "MIT",
  "homepage": "https://github.com/MrT0mX/practical-interview-directory#readme",
  "dependencies": {
    "remark-cli": "^12.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-alphabetize-lists": "^3.0.0",
    "remark-lint-hiring-without-whiteboards-links": "^0.3.2",
    "remark-lint-no-tabs": "^4.0.1",
    "remark-lint-no-trailing-spaces": "^4.0.3",
    "remark-lint-no-url-trailing-slash": "^3.0.1",
    "remark-lint-unordered-list-marker-style": "^4.0.1",
    "remark-preset-lint-recommended": "^7.0.1"
  },
  "remarkConfig": {
    "plugins": [
      "lint",
      "remark-preset-lint-recommended",
      "remark-lint-no-tabs",
      "remark-lint-no-trailing-spaces",
      "remark-lint-unordered-list-marker-style",
      "remark-lint-no-url-trailing-slash",
      "remark-lint-hiring-without-whiteboards-links",
      "lint-alphabetize-lists",
      [
        "remark-lint-list-item-indent",
        false
      ]
    ]
  }
}
